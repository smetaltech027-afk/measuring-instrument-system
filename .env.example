# Frontend public configuration (safe for GitHub Pages build)
# NEVER put Supabase service_role key, R2 credentials, or GAS secrets here.

# Base path for GitHub Pages (e.g. "/measuring-instrument-system/" or "/")
VITE_BASE_PATH=/measuring-instrument-system/

# Production origin + base path used to generate permanent QR URLs
# Lock this URL before printing physical QR labels!
VITE_PUBLIC_BASE_URL=https://smetaltech027-afk.github.io/measuring-instrument-system

# Supabase project URL & public anon key (RLS blocks anon table access)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Cloudflare Worker API base URL
VITE_WORKER_API_URL=https://measuring-instrument-api.your-subdomain.workers.dev

# Admin account email hint shown on login page (single admin scope)
VITE_ADMIN_EMAIL=smetaltech027@gmail.com

# Optional: Enable local preview mode with sample data (set to "false" in production)
VITE_DEMO_MODE=false
